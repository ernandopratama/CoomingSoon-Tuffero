# Keamanan untuk hosting LiteSpeed/Apache.

Options -Indexes

# Paksa HTTPS.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# File internal tidak untuk publik: dotfile (.git, .env), docs/, graphify-out/, markdown.
RewriteRule (^|/)\. - [F]
RewriteRule ^(docs|graphify-out)(/|$) - [F]
RewriteRule \.(md|gs|log)$ - [F]

<IfModule mod_headers.c>
    # connect-src: Apps Script membalas lewat redirect ke script.googleusercontent.com.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https://cdnjs.cloudflare.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com; form-action 'self' https://script.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
